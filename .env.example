# Copy to .env and fill in.

# Shared secret between the backend and the collector extension.
# Generate one:  openssl rand -hex 24
INGEST_TOKEN=change-me

# Host port the dashboard + API are published on.
ENTITYTRACK_PORT=8787

# Entity Corrector: how long a match with a missing loadout is deferred, and how
# many re-poll attempts before giving up with partial data.
REPOLL_DELAY_MINUTES=15
REPOLL_MAX_ATTEMPTS=3
